{
  "name": "pi-dcp",
  "version": "1.0.0",
  "description": "Dynamic Context Pruning (DCP) for Pi \u2014 automatic deduplication, error purging, superseded-write pruning, and range-based compression that keep the agent context window sharp.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "context-pruning",
    "context-management",
    "compression",
    "effect"
  ],
  "license": "MIT",
  "author": "arafays <me@arafays.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/arafays/pi-dcp-advanced.git"
  },
  "type": "module",
  "main": "src/main.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/main.ts"
    ]
  },
  "scripts": {
    "test": "aube exec vitest run"
  },
  "dependencies": {
    "dotenv": "^8.2.0",
    "effect": "^4.0.0-rc.108",
    "node-fetch": "^3.3.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.36.4",
    "@effect/vitest": "4.0.0-rc.108",
    "typebox": "^1.3.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
